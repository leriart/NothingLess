{
  "disks": [
    "/"
  ],
  "updateServiceEnabled": true,
  "batteryNotifications": {
    "enabled": true,
    "lowThreshold": 20,
    "criticalThreshold": 10,
    "autoPowerSave": true,
    "powerSaveThreshold": 15,
    "chargeLimit": 80,
    "chargeLimitEnabled": false
  },
  "idle": {
    "general": {
      "lock_cmd": "nothingless lock",
      "before_sleep_cmd": "loginctl lock-session",
      "after_sleep_cmd": "nothingless screen on"
    },
    "listeners": [
      {
        "timeout": 600,
        "onTimeout": "nothingless dim"
      },
      {
        "timeout": 900,
        "onTimeout": "nothingless lock"
      }
    ]
  },
  "pomodoro": {
    "workTime": 1500,
    "restTime": 300,
    "autoStart": false,
    "syncSpotify": false
  }
}